general {
	colors = true
	color_good = "#859900"
	color_bad = "#DC322F"
	interval = 1
}

order += "volume master"
order += "disk /"
order += "cpu_temperature 0"
order += "cpu_temperature 1"
order += "cpu_temperature 2"
order += "cpu_temperature 3"
order += "cpu_temperature 4"
order += "cpu_temperature 5"
order += "cpu_temperature 6"
order += "cpu_temperature 7"
order += "cpu_temperature 8"
order += "cpu_temperature 9"
order += "ethernet enp4s0"
order += "tztime local"

disk "/" {
	format = "💾 %free"
}

cpu_temperature 0 {
	format="♨️ %degrees C"
	path = "/sys/devices/platform/coretemp.0/hwmon/hwmon?/temp1_input"
}
cpu_temperature 1 {
	format="♨️ %degrees C"
	path = "/sys/devices/platform/coretemp.0/hwmon/hwmon?/temp2_input"
}
cpu_temperature 2 {
	format="♨️ %degrees C"
	path = "/sys/devices/platform/coretemp.0/hwmon/hwmon?/temp3_input"
}
cpu_temperature 3 {
	format="♨️ %degrees C"
	path = "/sys/devices/platform/coretemp.0/hwmon/hwmon?/temp4_input"
}
cpu_temperature 4 {
	format="♨️ %degrees C"
	path = "/sys/devices/platform/coretemp.0/hwmon/hwmon?/temp5_input"
}
cpu_temperature 5 {
	format="♨️ %degrees C"
	path = "/sys/devices/platform/coretemp.0/hwmon/hwmon?/temp6_input"
}
cpu_temperature 6 {
	format="♨️ %degrees C"
	path = "/sys/devices/platform/coretemp.0/hwmon/hwmon?/temp7_input"
}
cpu_temperature 7 {
	format="♨️ %degrees C"
	path = "/sys/devices/platform/coretemp.0/hwmon/hwmon?/temp8_input"
}
cpu_temperature 8 {
	format="♨️ %degrees C"
	path = "/sys/devices/platform/coretemp.0/hwmon/hwmon?/temp8_input"
}
cpu_temperature 9 {
	format="♨️ %degrees C"
	path = "/sys/devices/platform/coretemp.0/hwmon/hwmon?/temp8_input"
}


volume master {
	format = "🎵 %volume"
	device = "default"
	mixer = "Master"
	mixer_idx = 0
}


ethernet enp4s0 {
	format_up = "⚡ %ip (%speed)"
	format_down = "💀 network down"
}

tztime local {
	format = "%a %b %_d %Y ✨ %I:%M:%S"
}
